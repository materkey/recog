{
  "about": "An extension joins a room, the call goes on, it leaves and rejoins the same room, then switches rooms directly; the title updates, the history requests and the disconnect.",
  "config": {"golden": true},
  "steps": [
    {"op": "connect", "client": "ext", "origins": ["https://test.ktalk.ru"]},
    {"op": "send", "client": "ext", "frame": {"type": "clock_sync", "browser_time": 1783159199500}},
    {"op": "send", "client": "ext", "frame": {"type": "connection_status", "connected": true}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/room-1", "title": "Joining...", "platform": "ktalk"}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_title_update", "title": "Weekly sync"}},
    {"op": "send", "client": "ext", "frame": {"type": "participants_update", "participants": [{"id": "a", "name": "Alice", "isLocal": false, "micMuted": false}, {"id": "me", "name": "Me", "isLocal": true, "micMuted": true}], "localMicMuted": false}},
    {"op": "advance", "seconds": 1.5},
    {"op": "send", "client": "ext", "frame": {"type": "speaker_update", "seq": 1, "timestamp": 1783159200800, "speaker": {"id": "a", "name": "Alice", "isLocal": false}}},
    {"op": "call", "method": "append_segment", "args": {"speaker": "Alice", "speaker_id": "a", "text": "Привет всем"}},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Alice", "text": "Привет всем", "timestamp": "10:00:01", "segment_id": 1, "source_id": "pcm-a"}},
    {"op": "query", "method": "get_current_speaker"},
    {"op": "query", "method": "is_local_mic_muted"},
    {"op": "query", "method": "is_conference_active"},
    {"op": "query", "method": "compute_meeting_state"},
    {"op": "query", "method": "state"},
    {"op": "send", "client": "ext", "frame": {"type": "request_transcript"}},
    {"op": "send", "client": "ext", "frame": {"type": "ping"}},
    {"op": "advance", "seconds": 30},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_leave", "reason": "user_left"}},
    {"op": "query", "method": "state"},
    {"op": "advance", "seconds": 60},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/room-1", "title": "Weekly sync", "platform": "ktalk"}},
    {"op": "call", "method": "append_segment", "args": {"speaker": "Me", "speaker_id": "me", "text": "I am back", "is_local": true}},
    {"op": "advance", "seconds": 5},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/room-2", "title": "Retro", "platform": "ktalk"}},
    {"op": "call", "method": "append_segment", "args": {"speaker": "Bob", "speaker_id": "b", "text": "Second room"}},
    {"op": "query", "method": "state"},
    {"op": "advance", "seconds": 5},
    {"op": "close", "client": "ext"},
    {"op": "query", "method": "is_conference_active"},
    {"op": "query", "method": "state"}
  ]
}
