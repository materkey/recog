{
  "about": "Bounded sends: a stalled subscriber, channel and supervisor do not hold up the fan-out, each is marked timed out once, logged once and closed; later broadcasts skip it; the reaped socket runs its role's cleanup; a failing socket is logged per send; a dead supervisor makes a spawn report supervisor_disconnected.",
  "config": {"send_timeout": 0.05},
  "steps": [
    {"op": "connect", "client": "ext", "origins": ["https://test.ktalk.ru"]},
    {"op": "connect", "client": "webapp", "origins": ["http://127.0.0.1:9080"]},
    {"op": "send", "client": "webapp", "frame": {"type": "subscriber_hello"}},
    {"op": "connect", "client": "stuck_webapp", "origins": ["http://localhost:9080"]},
    {"op": "send", "client": "stuck_webapp", "frame": {"type": "subscriber_hello"}},
    {"op": "connect", "client": "channel"},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_hello"}},
    {"op": "connect", "client": "supervisor"},
    {"op": "send", "client": "supervisor", "frame": {"type": "supervisor_hello"}},
    {"op": "mode", "client": "stuck_webapp", "mode": "stall"},
    {"op": "mode", "client": "channel", "mode": "fail", "fail": "connection reset"},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/stall-room", "title": "Stalls", "platform": "ktalk"}},
    {"op": "sleep", "seconds": 0.2},
    {"op": "send", "client": "ext", "frame": {"type": "copilot_chat_message", "request_id": "c1", "text": "Through the stall"}},
    {"op": "sleep", "seconds": 0.2},
    {"op": "query", "method": "state"},
    {"op": "mode", "client": "supervisor", "mode": "stall"},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_leave"}},
    {"op": "sleep", "seconds": 0.2},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_spawn_request", "request_id": "s1"}},
    {"op": "sleep", "seconds": 0.2},
    {"op": "query", "method": "state"},
    {"op": "close", "client": "stuck_webapp"},
    {"op": "close", "client": "supervisor"},
    {"op": "mode", "client": "channel", "mode": "record"},
    {"op": "close", "client": "channel"},
    {"op": "query", "method": "state"}
  ]
}
