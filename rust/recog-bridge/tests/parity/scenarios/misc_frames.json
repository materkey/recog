    {"op": "send_text", "client": "ext", "text": "\"just a string\""},
    {"op": "send", "client": "ext", "frame": {"type": "something_new", "x": 1}},
    {"op": "send", "client": "ext", "frame": {"no_type": true}},
    {"op": "send", "client": "ext", "frame": {"type": 7}},
    {"op": "send", "client": "ext", "frame": {"type": "ping"}},
    {"op": "send", "client": "ext", "frame": {"type": "clock_sync"}},
    {"op": "send", "client": "ext", "frame": {"type": "clock_sync", "browser_time": "now"}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "", "title": "No url"}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://meet.vas3k.cloud/club-room", "title": null, "platform": "vas3k"}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_title_update", "title": "Club"}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_title_update", "title": ""}},
    {"op": "send", "client": "ext", "frame": {"type": "participants_update", "participants": [{"id": "a", "name": "Alice", "isLocal": false, "micMuted": false}]}},
    {"op": "send", "client": "ext", "frame": {"type": "speaker_update", "timestamp": 1783159200000, "speaker": {"id": "a", "name": "Alice", "isLocal": false}}},
    {"op": "advance", "seconds": 1.25},
    {"op": "periodic"},
    {"op": "connect", "client": "channel"},
    {"op": "fail", "client": "ext", "message": "no close frame received or sent"},
    {"op": "query", "method": "is_conference_active"},
    {"op": "query", "method": "state"},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_hello"}},
    {"op": "query", "method": "state"},
    {"op": "connect", "client": "ext2", "origins": ["https://test.ktalk.ru"]},
    {"op": "send", "client": "ext2", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/race", "title": "Race", "platform": "ktalk"}},
    {"op": "connect", "client": "late_subscriber", "origins": ["http://127.0.0.1:9080"]},
    {"op": "close", "client": "ext2"},
    {"op": "query", "method": "is_conference_active"},
    {"op": "send", "client": "late_subscriber", "frame": {"type": "subscriber_hello"}},
    {"op": "query", "method": "state"},
    {"op": "call", "method": "end_meeting_on_extension_gone"},
    {"op": "connect", "client": "ext3", "origins": ["https://test.ktalk.ru"]},
    {"op": "send", "client": "ext3", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/supervisor-race", "title": "Race 2", "platform": "ktalk"}},
    {"op": "connect", "client": "late_supervisor"},
    {"op": "close", "client": "ext3"},
    {"op": "send", "client": "late_supervisor", "frame": {"type": "supervisor_hello"}},
