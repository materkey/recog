{
  "about": "ai_settings_refresh from the webapp: a change goes to the supervisor (copilot_settings_changed) and the channel (copilot_policy_updated); switching the Copilot off fails the pending requests and the manual mirror and gates spawn, chat and channel frames; an unreadable file answers ai_settings_error; only subscribers may ask; meeting_started carries the policy.",
  "config": {"policy": {"instructions": "Be brief.", "revision": "r1", "enabled": true}},
  "steps": [
    {"op": "connect", "client": "webapp", "origins": ["http://127.0.0.1:9080"]},
    {"op": "send", "client": "webapp", "frame": {"type": "subscriber_hello"}},
    {"op": "connect", "client": "supervisor"},
    {"op": "send", "client": "supervisor", "frame": {"type": "supervisor_hello"}},
    {"op": "connect", "client": "channel"},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_hello"}},
    {"op": "connect", "client": "ext", "origins": ["https://test.ktalk.ru"]},
    {"op": "send", "client": "ext", "frame": {"type": "ai_settings_refresh"}},
    {"op": "send", "client": "webapp", "frame": {"type": "ai_settings_refresh", "revision": "ignored"}},
    {"op": "set", "policy": {"instructions": "Be very brief.", "revision": "r2", "enabled": true}},
    {"op": "send", "client": "webapp", "frame": {"type": "ai_settings_refresh"}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/settings-room", "title": "Settings", "platform": "ktalk"}},
    {"op": "send", "client": "ext", "frame": {"type": "copilot_chat_message", "request_id": "q1", "text": "Pending one"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_chat_message", "request_id": "q2", "text": "Pending two"}},
    {"op": "set", "policy": {"instructions": "Be very brief.", "revision": "r3", "enabled": false}},
    {"op": "send", "client": "webapp", "frame": {"type": "ai_settings_refresh"}},
    {"op": "query", "method": "state"},
    {"op": "query", "method": "copilot_policy_snapshot"},
    {"op": "send", "client": "ext", "frame": {"type": "copilot_chat_message", "request_id": "q3", "text": "Off?"}},
    {"op": "send", "client": "ext", "frame": {"type": "copilot_chat_message", "text": "Off, no id"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_spawn_request", "request_id": "s1"}},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_reply", "request_id": "q1", "kind": "answer", "text": "ignored"}},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_status", "request_id": "q1", "status": "done"}},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Alice", "text": "no ticks while off", "timestamp": "10:00:00", "segment_id": 1}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_leave"}},
    {"op": "set", "policy": {"error": "settings file is corrupt"}},
    {"op": "send", "client": "webapp", "frame": {"type": "ai_settings_refresh"}},
    {"op": "set", "policy": {"instructions": "Back.", "revision": "r4", "enabled": true}},
    {"op": "send", "client": "webapp", "frame": {"type": "ai_settings_refresh"}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/settings-room-2", "title": "Again", "platform": "ktalk"}},
    {"op": "query", "method": "state"}
  ]
}
