{
  "about": "transcript_tick to the channel: after five new segments, after fifteen seconds, not without a meeting or a channel; a reconnect keeps the counters, a leave clears them; the tick carries the identity and policy current when it is sent; source_id and segment_id on transcript frames.",
  "config": {},
  "steps": [
    {"op": "connect", "client": "ext", "origins": ["https://test.ktalk.ru"]},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Me", "text": "before any meeting", "timestamp": "09:59:59", "segment_id": 1, "is_local": true}},
    {"op": "connect", "client": "channel"},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_hello"}},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Me", "text": "still none", "timestamp": "09:59:59", "segment_id": 2}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/tick-room", "title": "Ticks", "platform": "ktalk"}},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Alice", "text": "one", "timestamp": "10:00:00", "segment_id": 1}},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Bob", "text": "two", "timestamp": "10:00:01", "segment_id": 2, "source_id": "pcm-b", "uncertain": true, "uncertain_reason": "mics_off"}},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "", "text": "", "timestamp": "10:00:02", "segment_id": 3, "correction": true}},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Alice", "text": "four", "timestamp": "10:00:03", "segment_id": 4}},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Alice", "text": "no id", "timestamp": "10:00:03"}},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Alice", "text": "five", "timestamp": "10:00:04", "segment_id": 5}},
    {"op": "query", "method": "state"},
    {"op": "advance", "seconds": 16},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Bob", "text": "six, later", "timestamp": "10:00:20", "segment_id": 6}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/tick-room", "title": "Ticks", "platform": "ktalk"}},
    {"op": "query", "method": "state"},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Bob", "text": "seven", "timestamp": "10:00:21", "segment_id": 7}},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_leave"}},
    {"op": "advance", "seconds": 20},
    {"op": "call", "method": "send_transcript", "args": {"speaker": "Bob", "text": "after leave", "timestamp": "10:00:41", "segment_id": 1}},
    {"op": "query", "method": "state"}
  ]
}
