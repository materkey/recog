{
  "about": "ktalk_only: a non-KTalk join is refused, a KTalk join rotates the writers then switches the capture on and makes the tab the owner, PCM only from the owner while recording, a leave from another tab ignored, the owner's conference disconnect ends the meeting, a capture that cannot start answers capture_unavailable.",
  "config": {"ktalk_only": true, "capture": true},
  "steps": [
    {"op": "connect", "client": "owner", "origins": ["https://test.ktalk.ru"]},
    {"op": "connect", "client": "other", "origins": ["https://meet.vas3k.cloud"]},
    {"op": "send", "client": "other", "frame": {"type": "meeting_join", "url": "https://meet.vas3k.cloud/room", "title": "Jitsi", "platform": "vas3k"}},
    {"op": "query", "method": "is_recording_active"},
    {"op": "send", "client": "owner", "frame": {"type": "pcm_chunk", "pid": "p1", "seq": 1, "chunk_start_ms": 1, "chunk_end_ms": 2, "sample_rate": 16000, "pcm_base64": "AAAA"}},
    {"op": "send", "client": "owner", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/only-room", "title": "Only", "platform": "ktalk"}},
    {"op": "query", "method": "is_recording_active"},
    {"op": "query", "method": "state"},
    {"op": "send", "client": "owner", "frame": {"type": "pcm_chunk", "pid": "p1", "seq": 2, "chunk_start_ms": 1, "chunk_end_ms": 2, "sample_rate": 16000, "pcm_base64": "AAAA"}},
    {"op": "send", "client": "other", "frame": {"type": "pcm_chunk", "pid": "p9", "seq": 3, "chunk_start_ms": 1, "chunk_end_ms": 2, "sample_rate": 16000, "pcm_base64": "AAAA"}},
    {"op": "send", "client": "other", "frame": {"type": "meeting_leave"}},
    {"op": "send", "client": "other", "frame": {"type": "connection_status", "connected": false}},
    {"op": "query", "method": "is_recording_active"},
    {"op": "send", "client": "owner", "frame": {"type": "connection_status", "connected": false}},
    {"op": "query", "method": "is_recording_active"},
    {"op": "query", "method": "state"},
    {"op": "send", "client": "owner", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/only-room", "title": "Only", "platform": "ktalk"}},
    {"op": "send", "client": "owner", "frame": {"type": "meeting_leave", "reason": "user_left"}},
    {"op": "query", "method": "is_recording_active"},
    {"op": "set", "capture_start_error": "no microphone"},
    {"op": "send", "client": "owner", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/only-room-2", "title": "Two", "platform": "ktalk"}},
    {"op": "query", "method": "state"},
    {"op": "set", "capture_start_error": null},
    {"op": "set", "meeting_change_error": "writer failed"},
    {"op": "send", "client": "owner", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/only-room-3", "title": "Three", "platform": "ktalk"}},
    {"op": "set", "meeting_change_error": null},
    {"op": "set", "capture_stop_error": "stuck"},
    {"op": "send", "client": "owner", "frame": {"type": "meeting_leave"}},
    {"op": "set", "capture_stop_error": null},
    {"op": "close", "client": "other"},
    {"op": "close", "client": "owner"}
  ]
}
