{
  "about": "Manual Copilot sessions from the webapp: spawn relayed and the mirror armed, spawn without a supervisor, stop (also without one), the supervisor's hello re-arming 'manual' before meeting_state, a manual chat without a meeting id, a conference preempting the session (manual_preempted to the webapp only, its pending chat stale), the late manual reply's terminal error, spawn refused during a conference, a stop during a conference still relayed.",
  "config": {},
  "steps": [
    {"op": "connect", "client": "webapp", "origins": ["http://127.0.0.1:9080"]},
    {"op": "send", "client": "webapp", "frame": {"type": "subscriber_hello"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_spawn_request", "request_id": "s0"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_stop_request", "request_id": "x0"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_spawn_request"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_stop_request", "request_id": 5}},
    {"op": "connect", "client": "supervisor"},
    {"op": "send", "client": "supervisor", "frame": {"type": "supervisor_hello", "current_meeting_id": null}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_spawn_request", "request_id": "s1", "extra": {"kept": true}}},
    {"op": "query", "method": "state"},
    {"op": "query", "method": "compute_meeting_state"},
    {"op": "send", "client": "supervisor", "frame": {"type": "copilot_agent_status", "status": "online"}},
    {"op": "connect", "client": "channel"},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_hello"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_chat_message", "request_id": "m1", "text": "Hello manual"}},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_reply", "request_id": "m1", "kind": "answer", "text": "Hi"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_chat_message", "request_id": "m2", "text": "Second"}},
    {"op": "close", "client": "supervisor"},
    {"op": "connect", "client": "supervisor_again"},
    {"op": "send", "client": "supervisor_again", "frame": {"type": "supervisor_hello", "current_meeting_id": "manual"}},
    {"op": "query", "method": "state"},
    {"op": "connect", "client": "ext", "origins": ["https://test.ktalk.ru"]},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/takeover", "title": "Takeover", "platform": "ktalk"}},
    {"op": "query", "method": "state"},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_reply", "request_id": "m2", "kind": "answer", "text": "Late"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_spawn_request", "request_id": "s2"}},
    {"op": "send", "client": "supervisor_again", "frame": {"type": "supervisor_hello", "current_meeting_id": "manual"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_stop_request", "request_id": "x1"}},
    {"op": "query", "method": "state"},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_leave"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_spawn_request", "request_id": "s3"}},
    {"op": "send", "client": "webapp", "frame": {"type": "copilot_stop_request", "request_id": "x2"}},
    {"op": "query", "method": "state"},
    {"op": "close", "client": "ext"},
    {"op": "close", "client": "channel"},
    {"op": "close", "client": "supervisor_again"},
    {"op": "close", "client": "webapp"}
  ]
}
