{
  "about": "user_profile_refresh from the webapp: the profile is re-read and applied to the microphone; a change goes to the channel as user_profile_updated, the asker gets user_profile_applied with the revision; no change answers applied only; read and apply failures answer user_profile_error; extensions may not ask; Copilot frames carry the identity.",
  "config": {"identity": {"local_user_name": "Me", "local_user_aliases": ["Me"], "local_user_profile_revision": "unconfigured", "local_user_identity_known": true}},
  "steps": [
    {"op": "connect", "client": "webapp", "origins": ["http://127.0.0.1:9080"]},
    {"op": "send", "client": "webapp", "frame": {"type": "subscriber_hello"}},
    {"op": "connect", "client": "channel"},
    {"op": "send", "client": "channel", "frame": {"type": "copilot_channel_hello"}},
    {"op": "connect", "client": "ext", "origins": ["https://test.ktalk.ru"]},
    {"op": "send", "client": "ext", "frame": {"type": "user_profile_refresh"}},
    {"op": "send", "client": "webapp", "frame": {"type": "user_profile_refresh", "revision": "hint"}},
    {"op": "set", "identity": {"local_user_name": "Алиса", "local_user_aliases": ["Алиса", "Alice"], "local_user_profile_revision": "p2", "local_user_identity_known": true}},
    {"op": "send", "client": "webapp", "frame": {"type": "user_profile_refresh"}},
    {"op": "query", "method": "user_identity_snapshot"},
    {"op": "set", "identity": {"local_user_name": "Алиса", "local_user_aliases": "AB", "local_user_profile_revision": "p3", "local_user_identity_known": true}},
    {"op": "send", "client": "webapp", "frame": {"type": "user_profile_refresh"}},
    {"op": "set", "identity": {"local_user_name": "Алиса", "local_user_profile_revision": "p4"}},
    {"op": "send", "client": "webapp", "frame": {"type": "user_profile_refresh"}},
    {"op": "set", "identity_error": "profile unreadable"},
    {"op": "send", "client": "webapp", "frame": {"type": "user_profile_refresh"}},
    {"op": "set", "identity": {"local_user_name": "Боб", "local_user_aliases": ["Боб"], "local_user_profile_revision": "p5", "local_user_identity_known": true}},
    {"op": "set", "apply_error": "microphone is busy"},
    {"op": "send", "client": "webapp", "frame": {"type": "user_profile_refresh"}},
    {"op": "query", "method": "user_identity_snapshot"},
    {"op": "set", "apply_error": null},
    {"op": "set", "identity": {"local_user_name": "Боб", "local_user_aliases": ["Боб"], "local_user_identity_known": true}},
    {"op": "send", "client": "webapp", "frame": {"type": "user_profile_refresh"}},
    {"op": "query", "method": "user_identity_snapshot"},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://test.ktalk.ru/profile-room", "title": "Profiles", "platform": "ktalk"}},
    {"op": "send", "client": "ext", "frame": {"type": "copilot_chat_message", "request_id": "c1", "text": "Who am I?"}},
    {"op": "send", "client": "channel", "frame": {"type": "get_recent_transcript_request", "request_id": "t1"}}
  ]
}
