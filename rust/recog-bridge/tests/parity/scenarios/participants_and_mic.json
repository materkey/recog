{
  "about": "participants_update with and without localMicMuted, the local tile, the queries the live process asks (own microphone, remote participants, the sole unmuted remote, all muted, a speaker muted), malformed participant lists.",
  "config": {},
  "steps": [
    {"op": "connect", "client": "ext", "origins": ["https://app.zoom.us"]},
    {"op": "send", "client": "ext", "frame": {"type": "meeting_join", "url": "https://zoom.us/j/123456", "title": "Zoom call", "platform": "zoom"}},
    {"op": "query", "method": "has_remote_participants"},
    {"op": "query", "method": "are_all_mics_muted"},
    {"op": "query", "method": "is_local_mic_muted"},
    {"op": "send", "client": "ext", "frame": {"type": "participants_update", "participants": [], "localMicMuted": true}},
    {"op": "query", "method": "is_local_mic_muted"},
    {"op": "send", "client": "ext", "frame": {"type": "participants_update", "participants": [{"id": "me", "name": "Me", "isLocal": true, "micMuted": false}, {"id": "a", "name": "Alice", "isLocal": false, "micMuted": true}, {"id": "b", "name": "Bob", "isLocal": false, "micMuted": false}], "localMicMuted": true}},
    {"op": "query", "method": "is_local_mic_muted"},
    {"op": "query", "method": "get_sole_unmuted_remote_participant"},
    {"op": "query", "method": "is_speaker_muted", "args": ["Alice"]},
    {"op": "query", "method": "is_speaker_muted", "args": ["Bob"]},
    {"op": "query", "method": "is_speaker_muted", "args": ["Nobody"]},
    {"op": "send", "client": "ext", "frame": {"type": "participants_update", "participants": [{"id": "me", "name": "Me", "isLocal": true, "micMuted": true}, {"id": "a", "name": "Alice", "micMuted": false}, {"id": "b", "name": "Bob", "isLocal": false, "micMuted": false}]}},
    {"op": "query", "method": "is_local_mic_muted"},
    {"op": "query", "method": "get_sole_unmuted_remote_participant"},
    {"op": "query", "method": "get_participants"},
    {"op": "send", "client": "ext", "frame": {"type": "participants_update", "participants": [{"id": "a", "name": "Alice", "isLocal": false}, {"id": "c"}], "localMicMuted": "yes"}},
    {"op": "query", "method": "get_participants"},
    {"op": "query", "method": "are_all_mics_muted"},
    {"op": "query", "method": "is_local_mic_muted"},
    {"op": "query", "method": "has_remote_participants"},
    {"op": "send", "client": "ext", "frame": {"type": "participants_update", "participants": [{"id": "a", "name": "Alice"}, "garbage", {"id": "z"}]}},
    {"op": "query", "method": "get_participants"},
    {"op": "send", "client": "ext", "frame": {"type": "participants_update", "participants": null}},
    {"op": "query", "method": "get_participants"},
    {"op": "send", "client": "ext", "frame": {"type": "participants_update"}},
    {"op": "query", "method": "get_participants"},
    {"op": "send", "client": "ext", "frame": {"type": "connection_status", "connected": false}},
    {"op": "query", "method": "get_participants"},
    {"op": "query", "method": "is_local_mic_muted"}
  ]
}
