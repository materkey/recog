[Unit]
Description=Recog copilot supervisor (auto-spawns the Claude session per meeting)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/Recog & Tools
Environment="HOME=/home/example"
Environment="RECOG_DATA_DIR=/srv/Recog data"
# TERM is pinned so Ink does not emit kitty-only DCS queries in the spawned TUI.
Environment=TERM=xterm-256color
Environment="PATH=/usr/bin:/opt/homebrew/bin:/home/example/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
ExecStart="/opt/Recog & Tools/bin/recog-copilot-supervisor" --repo-root "/opt/Recog & Tools"
Restart=always
RestartSec=5
StandardOutput=append:/srv/Recog data/logs/copilot-supervisor.stdout.log
StandardError=append:/srv/Recog data/logs/copilot-supervisor.stderr.log

[Install]
WantedBy=default.target
