{
  "manifest_version": 3,
  "name": "Jitsi Speaker Detector",
  "version": "1.4.0",
  "description": "Detects and displays the current active speaker in Jitsi-based video conferences (KTalk, vas3k.cloud, vkkovalev.work)",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.ktalk.ru/*",
    "https://meet.vas3k.cloud/*",
    "https://meet.vkkovalev.work/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.ktalk.ru/*", "https://meet.vas3k.cloud/*", "https://meet.vkkovalev.work/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "src/audio-worklet/downsampler.js"],
      "matches": ["https://*.ktalk.ru/*", "https://meet.vas3k.cloud/*", "https://meet.vkkovalev.work/*"]
    }
  ]
}
