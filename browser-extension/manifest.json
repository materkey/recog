{
  "manifest_version": 3,
  "name": "Jitsi Speaker Detector",
  "version": "1.4.3",
  "description": "Detects speakers and displays transcripts in KTalk, Jitsi, Google Meet, Zoom, and configured Element Call conferences",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.ktalk.ru/*",
    "https://meet.vas3k.cloud/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/wc/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.ktalk.ru/*",
        "https://meet.vas3k.cloud/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "src/audio-worklet/downsampler.js"
      ],
      "matches": [
        "https://*.ktalk.ru/*",
        "https://meet.vas3k.cloud/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/*"
      ]
    }
  ]
}
