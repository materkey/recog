# Hugging Face token for pyannote.audio models
# Get yours at: https://huggingface.co/settings/tokens
# Required for speaker diarization
HF_TOKEN=hf_your_token_here

# Speaker name for live microphone transcription
# Used as the default speaker label when transcribing from your mic
MIC_SPEAKER_NAME=Me

# External meetings directories (comma-separated, read-only)
# Federated access to meetings from other sources
# EXTERNAL_MEETINGS_PATHS=/path/to/ktalk-export/meetings,/path/to/other/meetings

# Per-speaker PCM transport from the KTalk Chrome extension (ADR-0018).
# When 1, the extension's AudioWorklet downsamples each participant's remote
# MediaStream to 16 kHz Int16 PCM and sends per-speaker chunks via WS; the
# pipeline switches from mixed BlackHole audio to per-pid ASR. Default 0.
# RECOG_PCM_TRANSPORT=0

# Per-speaker refine contour (tier-2 pass with word-level timestamps).
# When 1, RefineWorker reruns transcribe_with_timestamps on per-pid trailing
# PCM windows (20 s) on reply-close (3 s gap) or monolog cap (15 s) and
# rewrites live transcript.jsonl rows with `refined: true`. Requires
# RECOG_PCM_TRANSPORT=1 — no-op otherwise. Default 0.
# RECOG_PCM_REFINE=0
