# Secrets and legacy fallbacks only. Every other setting lives in the
# installation configuration ~/.config/recog/config.toml: copy
# deploy/config.example.toml there (docs/configuration.md). A variable set here
# still overrides the same setting in config.toml.

# Hugging Face token. OPTIONAL — pyannote diarization is gone; nothing in the
# live pipeline reads it today. Set it only if a HF-gated model is added back.
# Get yours at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here

# Speaker name for live microphone transcription
# Used as the default speaker label when transcribing from your mic
MIC_SPEAKER_NAME=Me

# Codex reasoning effort of transcript analysis, auto-increments, anchors, and
# titles, for a scenario that sets none in Settings. The models are
# [ai] claude_model and codex_model in config.toml.
CODEX_REASONING_EFFORT=xhigh
