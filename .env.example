# Hugging Face token for pyannote.audio models
# Get yours at: https://huggingface.co/settings/tokens
# Required for speaker diarization
HF_TOKEN=hf_your_token_here

# Speaker name for live microphone transcription
# Used as the default speaker label when transcribing from your mic
MIC_SPEAKER_NAME=Me

# External meetings directories (comma-separated, read-only)
# Federated access to meetings from other sources
# EXTERNAL_MEETINGS_PATHS=/path/to/ktalk-export/meetings,/path/to/other/meetings

# Per-speaker PCM transport from the KTalk Chrome extension (ADR-0018).
# When 1, the extension's AudioWorklet downsamples each participant's remote
# MediaStream to 16 kHz Int16 PCM and sends per-speaker chunks via WS; the
# pipeline switches from mixed BlackHole audio to per-pid ASR. Default 0.
# RECOG_PCM_TRANSPORT=0

# Stream-refine (Option B, ADR-0019): re-transcribe closed replies with 20s context
# and promote UI rows tier-1 → tier-2. Gated behind RECOG_PCM_TRANSPORT=1.
# Target WER: 33% → 24%. Default off — enable after operational validation.
RECOG_PCM_REFINE=0

# Override the WebSocket URL the frontend subscribes to for transcript_refine
# fanout from ktalk_bridge. Default matches the bridge's own listen address;
# set only if running the bridge on a non-default port.
# RECOG_BRIDGE_WS_URL=ws://localhost:8766

# Silero VAD v6 prefilter on the per-speaker PCM path. Drops near-silence
# chunks before GigaAM to avoid RNN-T hallucinations ("Да/Угу/Вот/Ок") on
# quiet windows. Gated on RECOG_PCM_TRANSPORT=1. Fails open (keeps chunk)
# if the silero-vad package or model fails to load. Default 0.
# RECOG_PCM_VAD=0
# Speech probability threshold (0..1). Chunks with max frame prob below
# this are treated as silence. Silero default is 0.5; we use 0.3 to bias
# toward keeping quiet real speech at the cost of a few false positives.
# RECOG_PCM_VAD_THRESHOLD=0.3

# Per-chunk diagnostic logging in _on_pcm_batch. When 1, every PCM batch
# item writes a one-line stderr record with VAD max-prob, rms, raw GigaAM
# text, and dedup decision. Grep logs/live.stderr.log for `[PCM-DEBUG]`.
# Independent of RECOG_PCM_TRANSPORT so it can be toggled during triage.
# RECOG_PCM_DEBUG=0

# Parallel 48 kHz Float32 source capture — the AudioWorklet emits the
# raw audio from Jitsi/Chrome *before* its 48→16 kHz decimation, written
# to <RECOG_PCM_CAPTURE_DIR>/<meeting>/<pid>_48k.raw (f32le) + .jsonl.
# Purpose: listen to source quality independent of what ASR sees. Not
# routed into GigaAM. Payload is 4× the 16 kHz path (~1.1 GB/hr/pid) —
# flip on only while recording a specific moment, then off. Gated on
# RECOG_PCM_TRANSPORT=1 and requires extension rebuild + service restart.
# RECOG_PCM_CAPTURE_48K=0
