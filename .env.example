# Hugging Face token. OPTIONAL — pyannote diarization is gone; nothing in the
# live pipeline reads it today. Set it only if a HF-gated model is added back.
# Get yours at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here

# Speaker name for live microphone transcription
# Used as the default speaker label when transcribing from your mic
MIC_SPEAKER_NAME=Me

# ASR inference device: auto (cuda > mps > cpu) | cuda | mps | cpu. An explicit
# device that is unavailable fails fast instead of silently landing on CPU.
# RECOG_ASR_DEVICE=auto

# PulseAudio/PipeWire monitor source for --system-audio pulse (Linux). Empty —
# the capture follows the default sink's monitor and reconnects when it changes.
# `pactl list short sources` lists the candidates.
# RECOG_PULSE_MONITOR_SOURCE=alsa_output.pci-0000_00_1f.3.analog-stereo.monitor

# Extra exact origins allowed to open the bridge / live-stream WebSockets,
# comma-separated. The conference hosts of the shipped extension are built in
# (recog/ws_origin.py); add your own host here AND to the extension's
# manifest.json (separate rebuild) when your conferences live elsewhere.
# RECOG_EXTRA_WS_ORIGINS=https://meet.example.com

# Codex model used by transcript analysis, auto-increments, anchors, and titles.
# Supported GPT-5.6 models: gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna.
# Requires Codex CLI 0.144.0 or newer.
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=xhigh

# External meetings directories (comma-separated, read-only)
# Federated access to meetings from other sources
# EXTERNAL_MEETINGS_PATHS=/path/to/ktalk-export/meetings,/path/to/other/meetings

# Override the WebSocket URL the frontend subscribes to for transcript_refine
# fanout from ktalk_bridge. Default matches the bridge's own listen address;
# set only if running the bridge on a non-default port.
# RECOG_BRIDGE_WS_URL=ws://localhost:8766

# ---------------------------------------------------------------------------
# Remote ASR offload to Z270XX (ADR-0020). OPT-IN, default OFF.
# ---------------------------------------------------------------------------
# When "remote", all four GigaAM paths (live per-speaker batch, offline CLI,
# refine word-timestamps, mic/mixed-fallback) are offloaded to the Z270XX
# OpenAI-Whisper-compatible gateway. A lazy local fallback (model loads only on
# the first remote failure) plus a circuit breaker keep meetings alive if the
# remote dies. Leave "local" (default) for unchanged, fully on-device behaviour.
# Only enable on a confirmed LAN (`ping` RTT < 5 ms) — a Tailscale DERP relay
# would wreck latency.
# RECOG_ASR_BACKEND=local

# Base URL of your ASR gateway. NO DEFAULT: RECOG_ASR_BACKEND=remote without
# this variable fails at startup instead of silently running on-device.
# RECOG_ASR_REMOTE_URL=https://<asr-gateway>/asr

# Model alias the gateway should use (see GET /v1/models on the gateway).
# RECOG_ASR_REMOTE_MODEL=gigaam

# Per-request timeout (seconds) for remote ASR calls. Bounds a stalled network
# round-trip before the circuit breaker / local fallback kicks in.
# RECOG_ASR_REMOTE_TIMEOUT_S=15

# Consecutive remote failures before the circuit breaker OPENS and routes
# straight to the local fallback.
# RECOG_ASR_CIRCUIT_FAILS=3

# Seconds the circuit stays OPEN before allowing one half-open remote probe.
# RECOG_ASR_CIRCUIT_OPEN_S=60

# ---------------------------------------------------------------------------
# ASR fallback buffering (docs/plans/2026-06-02-asr-fallback-buffering-design.md)
# ---------------------------------------------------------------------------
# Remote timeout (seconds) for LIVE chunk/batch requests. Shorter than
# RECOG_ASR_REMOTE_TIMEOUT_S so a 3s live chunk never blocks the pipeline for
# 15s when the gateway is down. Refine/offline keep the long timeout.
# RECOG_ASR_LIVE_TIMEOUT_S=5

# Live dedup window (seconds): last-words dedup applies only to chunks captured
# within this many seconds of the previous segment (covers the 0.5s overlap).
# Beyond it, a repeated phrase is real speech and is kept.
# DEDUP_MAX_GAP_S=2.0

# Max audio (seconds) buffered in memory while ASR is unavailable (remote down
# + local model still loading). Oldest audio is dropped beyond the cap.
# ASR_PENDING_BUFFER_CAP_S=600

# ---------------------------------------------------------------------------
# Copilot supervisor (docs/plans/2026-07-02-auto-copilot-session.md)
# ---------------------------------------------------------------------------
# Master switch for auto-spawning the Claude copilot tmux session per KTalk
# meeting. Set to 0 to keep the com.recog.copilot-supervisor daemon connected
# to the bridge (status reporting) but never spawn/kill a session — useful for
# falling back to the manual `./recog-service.sh claude` launch. Committed
# default here is OFF so a fresh install never spawns a Claude session
# unattended; flip to 1 once the copilot is set up.
RECOG_COPILOT_AUTOSPAWN=0

# Grace period (seconds) before the supervisor kills the copilot session after
# meeting_ended. A same-id rejoin within this window keeps the session alive
# (covers WS flaps / tab reloads that fire meeting_ended then re-emit the same
# meeting_id). Default: 90.
# RECOG_COPILOT_GRACE_S=90

# URL of the copilot_channel MCP daemon that the spawned Claude session (and
# the manual `./recog-service.sh claude` launch) connects to. Default matches
# the com.recog.copilot-channel listen address.
# RECOG_COPILOT_MCP_URL=http://127.0.0.1:8767/mcp
