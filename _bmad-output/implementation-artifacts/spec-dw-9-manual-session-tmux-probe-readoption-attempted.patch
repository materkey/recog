+# ---------------------------------------------------------------------------
+# Startup tmux-probe manual re-adoption (DW-9)
+# ---------------------------------------------------------------------------
+
+
+async def test_startup_probe_adopts_manual_and_hello_reports_it():
+    """given: a copilot tmux session survived a full restart and no conference
+           is active (the bridge replies meeting_state {active, "manual"})
+    when: a fresh supervisor starts
+    then: the startup probe adopts the session as "manual", supervisor_hello
+          carries "manual", and the same-id reconcile is a no-op — zero kills,
+          zero spawns; the session survives the restart
+    """
+    received = []
+
+    async def handler(websocket):
+        try:
+            first = await asyncio.wait_for(websocket.recv(), timeout=1.0)
+            received.append(first)
+            await websocket.send(json.dumps({
+                "type": "meeting_state",
+                "active": True,
+                "meeting_id": MANUAL_MEETING_ID,
+            }))
+        except Exception:
+            pass
+        await asyncio.sleep(0.3)
+
+    server, port = await _start_mock_bridge(handler)
+    runner = FakeRunner()
+    sup = Supervisor(
+        f"ws://127.0.0.1:{port}",
+        runner=runner,
+        grace_s=10.0,
+        autospawn=True,
+        session_alive_probe=lambda: True,
+    )
+    await sup.start()
+    try:
+        assert await _collect_hello(received) == {
+            "type": "supervisor_hello",
+            "current_meeting_id": MANUAL_MEETING_ID,
+        }
+        for _ in range(20):
+            if not sup._manual_adoption_provisional:
+                break
+            await asyncio.sleep(0.05)
+        assert runner.spawned == []
+        assert runner.kills == 0
+        assert sup.lifecycle.state is State.RUNNING
+        assert sup.lifecycle.meeting_id == MANUAL_MEETING_ID
+        assert sup._manual_adoption_provisional is False
+    finally:
+        await sup.stop()
+        server.close()
+        await server.wait_closed()
+
+
+async def test_provisional_manual_adoption_corrected_to_conference():
+    """given: the startup probe adopted a surviving session as "manual", but
+           the session actually belongs to conference "A" (supervisor-only
+           restart mid-meeting)
+    when: the bridge's meeting_state {active: true, meeting_id: "A"} arrives
+    then: the provisional guess is corrected by re-adopting under "A" — zero
+          kills, zero spawns (the tested mid-meeting invariant holds)
+    """
+    runner = FakeRunner()
+    sup = Supervisor(
+        runner=runner,
+        grace_s=10.0,
+        autospawn=True,
+        session_alive_probe=lambda: True,
+    )
+    await sup._startup_manual_readoption()
+    assert sup.lifecycle.state is State.RUNNING
+    assert sup.lifecycle.meeting_id == MANUAL_MEETING_ID
+    assert sup._manual_adoption_provisional is True
+
+    await sup.handle_frame({"type": "meeting_state", "active": True, "meeting_id": "A"})
+
+    assert runner.spawned == []
+    assert runner.kills == 0
+    assert sup.lifecycle.state is State.RUNNING
+    assert sup.lifecycle.meeting_id == "A"
+    assert sup._manual_adoption_provisional is False
+
+
