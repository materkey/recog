[Unit]
Description=Recog web UI (FastAPI on http://127.0.0.1:9080)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@/frontend
Environment=PYTHONUNBUFFERED=1
Environment="HOME=@HOME@"
Environment="PATH=@NODE_BIN@:@EXTRA_PATH@:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
ExecStart="@PYTHON@" "@REPO_DIR@/frontend/server.py"
# Mirrors launchd KeepAlive.SuccessfulExit=false — a clean exit is intentional.
Restart=on-failure
RestartSec=5
StandardOutput=append:@LOG_DIR@/frontend.stdout.log
StandardError=append:@LOG_DIR@/frontend.stderr.log

[Install]
WantedBy=default.target
