<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.recog.copilot-channel</string>

    <key>ProgramArguments</key>
    <array>
        @COMMAND@
    </array>

    <key>WorkingDirectory</key>
    <string>@REPO_DIR@</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>@LOG_DIR@/copilot-channel.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/copilot-channel.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@CLI_PATH_PREFIX@@NODE_BIN@:@EXTRA_PATH@:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>RECOG_DATA_DIR</key>
        <string>@DATA_DIR@</string>
    </dict>
</dict>
</plist>
