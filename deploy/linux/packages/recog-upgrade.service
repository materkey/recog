# Each user's services run a copy of the package in their home directory.
# recog setup enables this unit; it refreshes that copy after an upgrade,
# and at login for an upgrade that happened while the user was away.
[Unit]
Description=Move Recog to the version of the installed package
ConditionPathExists=%h/.local/share/recog/runtime/recog-release

[Service]
Type=oneshot
# services-release is written once setup has restarted the services on the
# copied release, so a run that fails halfway is not taken for done. Only cat:
# Arch's base has no cmp, and a missing command would rerun setup every login.
ExecCondition=/bin/sh -c 'test "$$(cat /usr/lib/recog/recog-release)" != "$$(cat %h/.local/share/recog/runtime/services-release 2>/dev/null)"'
ExecStart=/usr/lib/recog/bin/recog setup --no-env
# Setup refuses during a call, and the upgrade itself can make systemd
# re-execute this service manager under it: try again, 30 s to 10 min later.
Restart=on-failure
RestartSec=30s
RestartSteps=5
RestartMaxDelaySec=10min

[Install]
WantedBy=default.target
