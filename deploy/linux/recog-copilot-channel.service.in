[Unit]
Description=Recog copilot channel daemon (MCP HTTP <-> bridge WS)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUNBUFFERED=1
Environment="HOME=@HOME@"
Environment="RECOG_DATA_DIR=@DATA_DIR@"
Environment="PATH=@CLI_PATH_PREFIX@@NODE_BIN@:@EXTRA_PATH@:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
ExecStart=@COMMAND@
Restart=always
RestartSec=5
StandardOutput=append:@LOG_DIR@/copilot-channel.stdout.log
StandardError=append:@LOG_DIR@/copilot-channel.stderr.log

[Install]
WantedBy=default.target
