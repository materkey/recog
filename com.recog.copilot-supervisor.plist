<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.recog.copilot-supervisor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/vkkovalev/projects/recog/venv-gigaam/bin/python3</string>
        <string>-m</string>
        <string>recog.copilot_supervisor</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vkkovalev/projects/recog</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/vkkovalev/projects/recog/logs/copilot-supervisor.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/vkkovalev/projects/recog/logs/copilot-supervisor.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- ~/.local/bin is where `claude` lives; the supervisor spawns it via
             `tmux -L recog-copilot` and the tmux child inherits this PATH.
             TERM is pinned so Ink does not emit kitty-only DCS queries. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Users/vkkovalev/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/vkkovalev</string>
        <key>TERM</key>
        <string>xterm-256color</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
