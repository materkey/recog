# AI Provider Configuration
# Options: claude, codex, openrouter
AI_PROVIDER=claude

# Claude settings (for analyze-multi, both providers are called)
# Models: claude-haiku-4-5-20251001, claude-sonnet-4-5-20250929, claude-opus-4-6
CLAUDE_MODEL=claude-opus-4-6

# Codex settings
CODEX_MODEL=gpt-5.4
CODEX_REASONING_EFFORT=xhigh

# OpenRouter settings (only needed if AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3-haiku
